# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deployeasy

# Backend Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=your-jwt-secret-placeholder

# AWS Configuration (Use IAM Roles / Environment Variables)
AWS_REGION=us-east-1
AWS_ECR_REPOSITORY=deployeasy-apps
AWS_EKS_CLUSTER_NAME=deployeasy-eks-cluster
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your-github-client-id-placeholder
GITHUB_CLIENT_SECRET=your-github-client-secret-placeholder
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-placeholder

# Frontend
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

