generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String   @id @default(uuid())
  githubId    String?  @unique @map("github_id")
  username    String   @unique
  email       String   @unique
  avatarUrl   String?  @map("avatar_url")
  accessToken String?  @map("access_token")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projects   Project[]
  activities Activity[]

  @@map("users")
}

model Project {
  id              String   @id @default(uuid())
  name            String
  repository      String
  branch          String   @default("main")
  framework       String   @default("REACT")
  buildCommand    String   @default("npm run build") @map("build_command")
  startCommand    String   @default("npm start") @map("start_command")
  envVars         String?  @map("env_vars")
  status          String   @default("ACTIVE")
  liveUrl         String?  @map("live_url")
  deploymentCount Int      @default(0) @map("deployment_count")
  lastDeployedAt  DateTime? @map("last_deployed_at")
  autoDeploy       Boolean  @default(true) @map("auto_deploy")
  webhookSecret    String?  @map("webhook_secret")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deployments Deployment[]
  activities  Activity[]

  @@map("projects")
}

model Deployment {
  id               String    @id @default(uuid())
  version          String
  status           String    @default("QUEUED")
  branch           String    @default("main")
  commitHash       String?   @map("commit_hash")
  commitMsg        String?   @map("commit_msg")
  trigger          String    @default("manual")
  githubDeliveryId String?   @unique @map("github_delivery_id")
  startedAt        DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  duration      Int?
  logs          String?
  imageRepo     String?   @map("image_repo")
  imageTag      String?   @map("image_tag")
  imageId       String?   @map("image_id")
  failureReason String?   @map("failure_reason")
  k8sDeploymentName String? @map("k8s_deployment_name")
  k8sServiceName    String? @map("k8s_service_name")
  k8sIngressName    String? @map("k8s_ingress_name")
  liveUrl           String? @map("live_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("deployments")
}

model Activity {
  id        String   @id @default(uuid())
  type      String
  message   String
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("activities")
}
